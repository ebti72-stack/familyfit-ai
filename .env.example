# Copy to .env and fill in. Without these, the app runs in clearly-labelled local demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Turn on only after configuring the provider in Supabase → Authentication → Providers.
EXPO_PUBLIC_AUTH_PHONE=false   # needs an SMS provider (e.g. Twilio)
EXPO_PUBLIC_AUTH_APPLE=false   # needs Apple Developer Sign in with Apple + Supabase Apple provider
EXPO_PUBLIC_AUTH_GOOGLE=false  # needs Google OAuth client + Supabase Google provider

# Never put server secrets (service-role key, AI vision/LLM keys) in EXPO_PUBLIC_* variables:
# they are bundled into the app. Server keys belong in Supabase Edge Function secrets.
